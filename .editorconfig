root = true

[*]
indent_style = space
insert_final_newline = true
charset = utf-8

[*.cs]
indent_size = 4

[*.{csproj,props,targets,xaml,slnx,json}]
indent_size = 2

[*.cs]
# Public enum names (PropertyFlags, TypeFlags) mirror the XBF format and are kept for compatibility.
dotnet_diagnostic.CA1711.severity = none
